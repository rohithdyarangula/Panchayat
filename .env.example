# ==========================================
# CIVIC COMPLAINT TRIAGE & ROUTING - CONFIG TEMPLATE
# ==========================================

PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# 1. Open-Source AI Model: Google Gemma 2 (gemma-2-9b-it)
# Options: 'heuristic' (default offline), 'groq', 'ollama', 'huggingface'
AI_PROVIDER=heuristic
GROQ_API_KEY=your_groq_api_key_here
HF_API_KEY=your_huggingface_token_here
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMMA_MODEL_NAME=gemma2:9b

# 2. Location & Geocoding Engine
# OpenStreetMap Nominatim is enabled by default (Free, zero API key required)
GEOCODING_PROVIDER=osm_nominatim
GOOGLE_MAPS_API_KEY=optional_google_maps_key_here

# 3. Database
DB_PATH=./data/civic_triage.sqlite
